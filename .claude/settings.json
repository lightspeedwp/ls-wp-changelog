{
  "projectName": "changelog",
  "description": "Changelog skill for WordPress block themes and plugins: basic helper checks plus manual governance and release review",
  "version": "1.0.0",
  "settings": {
    "model": "claude-opus-5-5",
    "effort": "medium",
    "outputStyle": "concise",
    "fastMode": false
  },
  "permissions": {
    "allow": [
      "npm test",
      "npm run lint",
      "npm run test:jest",
      "npm run test:bats",
      "grep",
      "find",
      "git status",
      "git log",
      "git diff"
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    ".git/",
    "dist/",
    "coverage/",
    ".DS_Store",
    "*.swp",
    ".turbo/",
    "*.local.json"
  ],
  "aliases": {
    "test": "npm test",
    "test:vitest": "npm run test:vitest",
    "test:bats": "npm run test:bats",
    "test:watch": "npm run test:watch",
    "test:coverage": "npm run test:vitest",
    "help": "less README.md"
  },
  "testing": {
    "framework": "Vitest + BATS",
    "testMatch": [
      "sub-skills/*/__tests__/**/*.test.js",
      "sub-skills/*/tests/**/*.bats"
    ],
    "testEnvironment": "node",
    "testTimeout": 120000,
    "coverage": true,
    "coverageThreshold": {
      "lines": 80,
      "functions": 80,
      "branches": 80,
      "statements": 80
    },
    "bashCompatibility": "3.2+",
    "commands": {
      "test": "npm test -- with coverage",
      "testVitest": "npm run test:vitest -- runs Vitest tests (all packages)",
      "testBats": "npm run test:bats -- runs BATS integration tests",
      "testWatch": "npm run test:watch -- continuous testing",
      "testSingle": "npm test -- <filename>.test.js"
    },
    "coLocation": {
      "description": "Vitest tests are co-located with source scripts in __tests__ folders",
      "locations": [
        "sub-skills/branch-context-mapper/__tests__/",
        "sub-skills/changelog-validator/__tests__/"
      ],
      "pattern": "Tests placed alongside shell scripts in __tests__ folder"
    },
    "integration": {
      "framework": "BATS",
      "locations": [
        "sub-skills/branch-context-mapper/tests/",
        "sub-skills/changelog-validator/tests/"
      ],
      "description": "End-to-end shell script integration testing",
      "requirements": {
        "install": "brew install bats-core (macOS) or sudo apt-get install bats (Linux)"
      }
    }
  },
  "skills": [
    "branch-context-mapper",
    "changelog-validator"
  ],
  "subSkills": {
    "branch-context-mapper": {
      "path": "sub-skills/branch-context-mapper",
      "description": "Map a branch type to a changelog category and version-bump hint (advisory; no breaking-change detection)"
    },
    "changelog-validator": {
      "path": "sub-skills/changelog-validator",
      "description": "Basic CHANGELOG.md title and version-heading check; governance and quality review are manual"
    }
  },
  "documentation": {
    "main": "README.md",
    "onboarding": "docs/TEAM_ONBOARDING.md",
    "roadmap": "docs/PHASE_2_ROADMAP.md",
    "standards": "docs/ORG_STANDARDS.md",
    "constitution": ".specify/memory/constitution.md",
    "mapper": "sub-skills/branch-context-mapper/SKILL.md",
    "validator": "sub-skills/changelog-validator/SKILL.md",
    "claude": "CLAUDE.md",
    "agents": "AGENTS.md",
    "changelog": "CHANGELOG.md",
    "contributing": "README.md#contributing"
  },
  "gitHooks": {
    "engine": "lefthook",
    "config": "lefthook.yaml",
    "hooks": {
      "pre-commit": "Branch type check, root changelog format check, Vitest tests (80% coverage threshold) and BATS tests",
      "commit-msg": "Commit message format check (type(scope): message)",
      "pre-push": "Final validation before push"
    }
  },
  "spec-kit": {
    "installed": true,
    "version": "1.2.5",
    "integration": "Claude Code manual mode",
    "location": ".specify/",
    "constitution": ".specify/memory/constitution.md"
  }
}

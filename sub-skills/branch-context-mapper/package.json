{
  "name": "branch-context-mapper",
  "version": "1.0.0",
  "description": "Maps git branch types to changelog categories and version bumps",
  "main": "scripts/branch-context-mapper.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightspeedwp/ls-wp-changelog.git",
    "directory": "sub-skills/branch-context-mapper"
  },
  "scripts": {
    "test": "npm run lint && npm run test:vitest && npm run test:bats",
    "test:vitest": "npm --prefix ../.. run test:unit -- sub-skills/branch-context-mapper",
    "test:bats": "bats tests",
    "test:watch": "npm --prefix ../.. run test:watch -- sub-skills/branch-context-mapper",
    "lint": "npm run lint:js && npm run format:check",
    "lint:js": "eslint . --ext .js,.cjs",
    "lint:fix": "npm run lint:js -- --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "changelog",
    "branch",
    "semantic-versioning",
    "git",
    "automation"
  ],
  "author": "LightSpeed WP",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.53.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

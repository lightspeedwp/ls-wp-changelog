{
  "name": "@lightspeedwp/changelog-skill",
  "version": "1.0.0",
  "description": "Changelog skill for managing CHANGELOG.md files",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightspeedwp/ls-wp-changelog.git"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "test": "npm run test:vitest && npm run test:bats",
    "test:vitest": "vitest run --coverage --configLoader runner",
    "test:unit": "vitest run --configLoader runner",
    "test:bats": "bats tests",
    "test:watch": "vitest --configLoader runner"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}

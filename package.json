{
  "name": "@lightspeedwp/changelog-skill",
  "version": "1.0.0",
  "description": "Changelog skill for managing CHANGELOG.md files",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightspeedwp/ls-wp-changelog.git"
  },
  "scripts": {
    "test": "npm run test:jest && npm run test:vitest && npm run test:bats",
    "test:jest": "jest --roots=scripts --coverage --coverage-threshold='{\"lines\":90,\"functions\":90,\"branches\":90,\"statements\":90}' __tests__",
    "test:vitest": "vitest run --coverage --configLoader runner",
    "test:bats": "bats tests",
    "test:watch": "jest --roots=scripts --watch __tests__"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "jest": "^29.7.0",
    "vitest": "5.1.0"
  }
}
